---
import SignalMap from '../components/SignalMap.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { REPOSITORY_URL } from '../lib/document-manifest.mjs';

const description = 'ZHIYI 是面向生产级 AI Agent 的 Runtime 设计基线，聚焦可恢复执行、上下文治理、安全工具调用、Memory 与全链路可观测。';
---

<SiteLayout title="ZHIYI · 可靠运行的 Agent Runtime 设计基线" description={description}>
  <section class="hero site-shell" aria-labelledby="hero-title">
    <div class="hero__copy reveal reveal--1">
      <p class="eyebrow"><span aria-hidden="true">●</span> AGENT RUNTIME / DESIGN BASELINE</p>
      <h1 id="hero-title">让 Agent 不只会回答，<br /><span>还能可靠运行。</span></h1>
      <p class="hero__lead">
        ZHIYI 把模型、Memory、Context、Tool 与 Agent Loop 置于可恢复、
        可治理、可观测的工程边界之内。
      </p>
      <p class="hero__audience">为 Agent 开发者、平台工程师、业务团队与安全治理者设计。</p>
      <div class="hero__actions">
        <a class="button button--primary" href="/docs/architecture/">阅读技术方案 <span aria-hidden="true">→</span></a>
        <a class="button button--quiet" href="/docs/roadmap/">查看项目路线图</a>
      </div>
    </div>
    <div class="hero__visual reveal reveal--2">
      <SignalMap />
    </div>
  </section>

  <aside class="status-rail" data-testid="project-status" aria-label="项目当前状态">
    <div class="site-shell status-rail__inner">
      <span class="status-rail__label">CURRENT STATE</span>
      <strong>方案基线</strong>
      <span>SDD 治理已建立</span>
      <span>Runtime 尚未实现</span>
      <span>M0 等待正式启动</span>
    </div>
  </aside>

  <section class="thesis site-shell section-space reveal reveal--3" aria-labelledby="thesis-title">
    <div class="section-index" aria-hidden="true">01 / WHY</div>
    <div class="section-heading">
      <p class="eyebrow">RELIABILITY IS THE PRODUCT</p>
      <h2 id="thesis-title">真正困难的不是接上模型，<br />而是控制每一次执行。</h2>
    </div>
    <div class="thesis__body">
      <p>
        一个可演示的 Agent 只需要 Prompt、模型与工具。一个能进入生产的 Agent，
        还必须回答：中断后如何恢复？副作用如何避免重复？上下文为什么被选中？
        Memory 谁批准写入？失败和成本如何被看见？
      </p>
      <a class="text-link" href="/docs/product-value/">理解产品价值 <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="runtime section-space" aria-labelledby="runtime-title">
    <div class="site-shell runtime__inner">
      <div class="section-index" aria-hidden="true">02 / SYSTEM</div>
      <div class="section-heading runtime__heading">
        <p class="eyebrow">CONTROLLED AGENT LOOP</p>
        <h2 id="runtime-title">一次运行，六道可验证边界。</h2>
        <p>框架负责执行，ZHIYI 负责产品语义与治理边界。</p>
      </div>

      <ol class="boundary-list">
        <li>
          <span class="boundary-list__number">01</span>
          <div><h3>Context Manifest</h3><p>按信任级别、预算和新鲜度组装上下文，并留下选择证据。</p></div>
          <span class="boundary-list__state">DESIGN</span>
        </li>
        <li>
          <span class="boundary-list__number">02</span>
          <div><h3>Model Gateway</h3><p>统一模型能力、结构化输出、成本预算、超时与故障转移。</p></div>
          <span class="boundary-list__state">DESIGN</span>
        </li>
        <li>
          <span class="boundary-list__number">03</span>
          <div><h3>Policy & Approval</h3><p>高风险写操作在副作用发生前接受确定性策略和人工审批。</p></div>
          <span class="boundary-list__state">DESIGN</span>
        </li>
        <li>
          <span class="boundary-list__number">04</span>
          <div><h3>Idempotent Tool</h3><p>以至少一次执行与幂等键处理重试，不虚假承诺外部副作用恰好一次。</p></div>
          <span class="boundary-list__state">DESIGN</span>
        </li>
        <li>
          <span class="boundary-list__number">05</span>
          <div><h3>Durable State</h3><p>Run 绑定不可变 AgentVersion，通过 checkpoint 恢复而不重复已完成步骤。</p></div>
          <span class="boundary-list__state">DESIGN</span>
        </li>
        <li>
          <span class="boundary-list__number">06</span>
          <div><h3>Evidence, not CoT</h3><p>保留决策、摘要、引用和 Tool 结果，不暴露隐藏推理链。</p></div>
          <span class="boundary-list__state">DESIGN</span>
        </li>
      </ol>
      <a class="button button--primary runtime__action" href="/docs/architecture/">查看完整架构 <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="governance site-shell section-space" aria-labelledby="governance-title">
    <div class="section-index" aria-hidden="true">03 / GOVERNANCE</div>
    <div class="section-heading">
      <p class="eyebrow">SPECIFICATION BEFORE IMPLEMENTATION</p>
      <h2 id="governance-title">设计不会静默输给代码。</h2>
    </div>
    <div class="governance__grid">
      <div class="governance__statement">
        <p>每个变更从可验收 Spec 开始，经 Plan、Tasks、Analyze、Implement 与 Converge 闭环。</p>
        <p>Hook 与 CI 检查实现路径、文档影响和架构边界；发生漂移时，同步设计或撤销实现。</p>
      </div>
      <dl class="evidence-list">
        <div><dt>01</dt><dd><strong>单一事实源</strong><span>宪法 → Spec → Plan → Tasks → 文档 → 代码</span></dd></div>
        <div><dt>02</dt><dd><strong>硬性架构边界</strong><span>报告不能豁免分层、安全或租户隔离违规</span></dd></div>
        <div><dt>03</dt><dd><strong>端到端追踪</strong><span>每个实现文件、需求与验收结果都可回溯</span></dd></div>
      </dl>
    </div>
    <a class="text-link" href="/docs/development/sdd/">查看 SDD 开发规范 <span aria-hidden="true">↗</span></a>
  </section>

  <section class="roadmap section-space" aria-labelledby="roadmap-title">
    <div class="site-shell">
      <div class="section-index" aria-hidden="true">04 / ROADMAP</div>
      <div class="section-heading roadmap__heading">
        <p class="eyebrow">DELIVER IN VERIFIED LAYERS</p>
        <h2 id="roadmap-title">从可靠执行开始，而不是从功能数量开始。</h2>
      </div>
      <ol class="roadmap-line">
        <li><span>M0</span><div><strong>Runtime Alpha</strong><p>建立 Agent Loop、持久 Run、故障恢复、事件流与硬预算约束。</p></div><em>计划</em></li>
        <li><span>M1</span><div><strong>Platform Beta</strong><p>加入 Context、Memory、RAG、写 Tool 审批、评测与最小控制台。</p></div><em>计划</em></li>
        <li><span>M2</span><div><strong>Production V1</strong><p>完成 MCP、受控 Subagent、OIDC/RBAC、SLO、安全审计与升级回滚。</p></div><em>计划</em></li>
      </ol>
      <a class="button button--quiet" href="/docs/roadmap/">查看完整路线图</a>
    </div>
  </section>

  <section class="docs-cta site-shell section-space" aria-labelledby="docs-title">
    <p class="eyebrow">READ THE SOURCE OF TRUTH</p>
    <h2 id="docs-title">所有判断，都从受治理文档开始。</h2>
    <p>先理解价值与范围，再进入功能、架构和开发治理。网站不维护第二份正文副本。</p>
    <div class="docs-cta__actions">
      <a class="button button--primary" href="/docs/product-value/">进入文档 <span aria-hidden="true">→</span></a>
      <a class="button button--quiet" href={REPOSITORY_URL}>查看 GitHub</a>
    </div>
  </section>
</SiteLayout>
